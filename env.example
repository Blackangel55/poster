# .env — Copy this to .env and fill in your values
# Load with: pip install python-dotenv  and add load_dotenv() to bot.py
# OR just export these in your shell / Docker run command

# ── Telegram ──────────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# ── Spidy Poster API ──────────────────────────────────────
SPIDY_KEY=your_spidy_api_key_here
SPIDY_BASE=https://api.spidyposter.com/v1/fetch

# ── Optional Bot Settings ─────────────────────────────────
SESSION_NAME=ott_poster_bot
PLOT_MAX_CHARS=280
API_TIMEOUT=15
KEEP_ALIVE=true
PORT=8000
